[
  { "tool": "lease_device", "args": { "platform": "ios", "device": "${DEVICE}", "os_version": "${OS}" }, "optional": ["DEVICE", "OS"], "label": "lease", "stopOnFail": true },
  { "tool": "install_app", "args": { "path": "${APP}" }, "label": "install_app", "requires": ["APP"], "timeoutSec": 1200 },
  { "tool": "launch_app", "args": { "app_id": "${APP_ID}" }, "label": "launch", "stopOnFail": true },
  { "tool": "launch_app", "args": { "app_id": "${APP_ID}", "console": true }, "label": "launch_console" },
  { "tool": "inspect_screen", "label": "inspect" },
  { "tool": "take_screenshot", "args": { "note": "app after launch" }, "label": "screenshot" },
  { "tool": "handle_alert", "args": { "action": "get" }, "label": "alert_get" },
  { "tool": "tap", "args": { "text": "${TAP_TEXT}" }, "label": "tap_text", "requires": ["TAP_TEXT"] },
  { "tool": "type_text", "args": { "text": "Tapdance Für Elise", "into_text": "${TYPE_INTO}" }, "label": "type_into_field", "requires": ["TYPE_INTO"] },
  { "tool": "inspect_screen", "args": { "compact": true }, "label": "check_typed", "requires": ["TYPE_INTO"], "expectText": "Für Elise" },
  { "tool": "swipe", "args": { "direction": "up" }, "label": "swipe" },
  { "tool": "start_recording", "label": "record_start" },
  { "tool": "swipe", "args": { "direction": "down" }, "label": "swipe_while_recording" },
  { "tool": "stop_recording", "label": "record_stop" },
  { "tool": "get_logs", "args": { "app_id": "${APP_ID}", "lines": 40 }, "label": "logs_app" },
  { "tool": "get_crash_logs", "args": { "lines": 40 }, "label": "crash_logs" },
  { "tool": "crash_reports", "args": { "app_id": "${APP_ID}" }, "label": "crash_reports" },
  { "tool": "push_file", "args": { "path": "push.txt", "destination": "documents", "app_id": "${APP_ID}", "name": "field-test.txt" }, "label": "push_documents" },
  { "tool": "launch_app", "args": { "app_id": "${APP_ID}", "locale": "de-DE" }, "label": "launch_de" },
  { "tool": "take_screenshot", "args": { "note": "app in de-DE" }, "label": "screenshot_de" },
  { "tool": "set_device_setting", "args": { "name": "orientation", "value": "landscape" }, "label": "rotate_landscape" },
  { "tool": "set_device_setting", "args": { "name": "orientation", "value": "portrait" }, "label": "rotate_portrait" },
  { "tool": "audit_screen", "label": "audit" },
  { "tool": "opened_links", "label": "opened_links" },
  { "tool": "list_apps", "label": "list_apps" },
  { "tool": "kill_app", "args": { "app_id": "${APP_ID}" }, "label": "kill" },
  { "tool": "clear_app_data", "args": { "app_id": "${APP_ID}" }, "label": "clear_data" },
  { "tool": "launch_app", "args": { "app_id": "${APP_ID}" }, "label": "launch_after_clear" },
  { "tool": "get_test_artifacts", "label": "artifacts" },
  { "tool": "release_device", "label": "release" }
]
