[
  { "tool": "__list" },
  { "tool": "list_devices", "label": "list_devices", "expectText": "\"hosts\"" },
  { "tool": "lease_device", "args": { "platform": "android", "device": "${ANDROID_DEVICE}", "os_version": "${ANDROID_OS}", "target": "${ANDROID_TARGET}" }, "optional": ["ANDROID_DEVICE", "ANDROID_OS", "ANDROID_TARGET"], "label": "lease_android", "timeoutSec": 900 },
  { "tool": "get_device_status", "label": "status_android", "expectText": "\"platform\": \"android\"" },
  { "tool": "lease_device", "args": { "platform": "ios" }, "label": "second_lease_refused", "expectError": "LEASE_ALREADY_HELD" },
  { "tool": "install_app", "args": { "path": "${APK}" }, "label": "install_apk", "requires": ["APK"], "timeoutSec": 1200 },
  { "tool": "launch_app", "args": { "app_id": "${ANDROID_APP_ID}" }, "label": "launch_android", "requires": ["ANDROID_APP_ID"] },
  { "tool": "press_key", "args": { "key": "home" }, "label": "key_home_android" },
  { "tool": "inspect_screen", "args": { "compact": true }, "label": "inspect_android" },
  { "tool": "swipe", "args": { "direction": "up" }, "label": "swipe_android" },
  { "tool": "take_screenshot", "args": { "note": "Android over MCP, two hosts", "include_image": true }, "label": "screenshot_android" },
  { "tool": "get_logs", "args": { "lines": 20 }, "label": "logs_android" },
  { "tool": "release_device", "label": "release_android", "always": true },
  { "tool": "lease_device", "args": { "platform": "ios", "device": "${IOS_DEVICE}", "os_version": "${IOS_OS}", "target": "${IOS_TARGET}" }, "optional": ["IOS_DEVICE", "IOS_OS", "IOS_TARGET"], "label": "lease_ios", "timeoutSec": 900 },
  { "tool": "get_device_status", "label": "status_ios", "expectText": "\"platform\": \"ios\"" },
  { "tool": "install_app", "args": { "path": "${APP}" }, "label": "install_app_ios", "requires": ["APP"], "timeoutSec": 1200 },
  { "tool": "launch_app", "args": { "app_id": "${IOS_APP_ID}" }, "label": "launch_ios", "requires": ["IOS_APP_ID"] },
  { "tool": "press_key", "args": { "key": "home" }, "label": "key_home_ios" },
  { "tool": "inspect_screen", "args": { "compact": true, "app_id": "com.apple.springboard" }, "label": "inspect_ios" },
  { "tool": "swipe", "args": { "direction": "left" }, "label": "swipe_ios" },
  { "tool": "take_screenshot", "args": { "note": "iOS over MCP, two hosts", "include_image": true }, "label": "screenshot_ios" },
  { "tool": "get_logs", "args": { "lines": 20 }, "label": "logs_ios" },
  { "tool": "release_device", "label": "release_ios", "always": true },
  { "tool": "get_test_artifacts", "label": "artifacts" }
]
