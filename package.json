{
  "name": "tapdance-monorepo",
  "private": true,
  "description": "Let your agent put your app through its paces.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "tsc -b packages/cli packages/mcp",
    "test": "pnpm build && vitest run --project unit",
    "test:integration": "pnpm build && vitest run --project integration",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "docs:cli": "node scripts/gen-cli-index.mjs",
    "docs:check": "node scripts/gen-cli-index.mjs --check"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}