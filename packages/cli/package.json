{
  "name": "@tapdance/cli",
  "version": "0.1.0",
  "description": "Let your agent put your app through its paces. CLI and MCP server for Android emulators and iOS simulators.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mirzemehdi/tapdance"
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
