diff --git a/dist/drivers/android/baseline-cpu.js b/dist/drivers/android/baseline-cpu.js
new file mode 100644
index 0000000000000000000000000000000000000000..e049c5ef120f8affa93daac4fa8a3180a51cfdda
--- /dev/null
+++ b/dist/drivers/android/baseline-cpu.js
@@ -0,0 +1,57 @@
+// tapdance patch (#103): one info line each time a seed's or a saved baseline's boot snapshot is
+// saved, with the guest CPU at that moment. Every Android device is a copy booted from that snapshot,
+// so the logs show whether the copies start from a calm or a busy guest (tapdance#139).
+//
+// It only observes. An earlier version of this patch (#79, #101, on Simlock 0.5.0) waited (bounded
+// at 120 s) for a calm guest and ran `cmd package bg-dexopt-job` (bounded at 90 s) before the
+// capture. Measured on a Google Cloud N2 VM (nested virtualisation), the dexopt job timed out every
+// time, the wait gave up at its bound every time with the guest still ~95 % busy, and cold leases
+// grew past Tapdance's 330 s lease wait. So the save is upstream's; the reading below costs one
+// /proc/stat sample pair (about a second).
+
+/** The two /proc/stat reads are this far apart. */
+export const BASELINE_CPU_SAMPLE_MS = 1_000;
+
+/**
+ * The CPU counters from the `cpu` line of /proc/stat: user nice system idle iowait irq softirq
+ * steal. Waiting on I/O or for the host's CPU (steal) counts as busy. `undefined` when absent.
+ */
+export function parseProcStatCpu(stdout) {
+    const line = stdout.split(/\r?\n/).map((l) => l.trim()).find((l) => /^cpu\s/.test(l));
+    if (line === undefined)
+        return undefined;
+    const fields = line.split(/\s+/).slice(1, 9).map(Number);
+    if (fields.length < 4 || !fields.every((v) => Number.isFinite(v)))
+        return undefined;
+    return { idle: fields[3], total: fields.reduce((a, b) => a + b, 0) };
+}
+
+/** The busy share between two reads, 0..1; `undefined` when it cannot be told. */
+export function busyBetween(previous, current) {
+    const total = current.total - previous.total;
+    const idle = current.idle - previous.idle;
+    if (total <= 0 || idle < 0)
+        return undefined;
+    return Math.min(1, Math.max(0, (total - idle) / total));
+}
+
+/**
+ * One sample pair: read, wait `intervalMs`, read. Resolves the busy share (0..1, two decimals) or
+ * `undefined` when the counters cannot be read. Never throws.
+ */
+export async function sampleGuestBusy({ readCpu, delay, intervalMs = BASELINE_CPU_SAMPLE_MS }) {
+    try {
+        const first = await readCpu();
+        if (first === undefined)
+            return undefined;
+        await delay(intervalMs);
+        const second = await readCpu();
+        if (second === undefined)
+            return undefined;
+        const busy = busyBetween(first, second);
+        return busy === undefined ? undefined : Math.round(busy * 100) / 100;
+    }
+    catch {
+        return undefined;
+    }
+}
