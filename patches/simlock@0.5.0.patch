diff --git a/dist/drivers/android/guest-settle.js b/dist/drivers/android/guest-settle.js
new file mode 100644
index 0000000000000000000000000000000000000000..9720b997e8de28414b23b6524b6314ccf26f9e10
--- /dev/null
+++ b/dist/drivers/android/guest-settle.js
@@ -0,0 +1,69 @@
+// tapdance patch (#79): the clean baseline snapshot is taken only from a settled guest.
+//
+// `sys.boot_completed`, the stopped boot animation and an answering package manager all pass while the
+// guest is still busy for minutes (dexopt, Play services, System UI starting). A clean baseline saved
+// then makes every later restore of it -- each warm spare, each reclaim -- resume a busy guest, so the
+// next lease gets slow commands and "System UI isn't responding" dialogs. So before the baseline is
+// captured (once per device, on its first boot), the driver waits until the guest's CPU, read from the
+// first line of its /proc/stat, has been busy at most `busyThreshold` of the time for `samples`
+// consecutive intervals. The wait is bounded: past `boundMs` (or when the counters cannot be read) the
+// baseline is captured as before this patch. Ordinary boots and reclaims do not wait.
+
+/** The guest counts as settled when it was busy at most this share of an interval. */
+export const GUEST_SETTLED_BUSY = 0.5;
+/** Consecutive calm intervals needed. */
+export const GUEST_SETTLED_SAMPLES = 2;
+export const GUEST_SETTLE_INTERVAL_MS = 1_000;
+/** After this long the baseline is captured anyway, as before the patch. */
+export const GUEST_SETTLE_BOUND_MS = 120_000;
+
+/**
+ * The CPU counters from the `cpu` line of /proc/stat: user nice system idle iowait irq softirq
+ * steal. Waiting on I/O or for the host's CPU (steal) counts as busy. `undefined` when absent.
+ */
+export function parseProcStatCpu(stdout) {
+    const line = stdout.split(/\r?\n/).map((l) => l.trim()).find((l) => /^cpu\s/.test(l));
+    if (line === undefined)
+        return undefined;
+    const fields = line.split(/\s+/).slice(1, 9).map(Number);
+    if (fields.length < 4 || !fields.every((v) => Number.isFinite(v)))
+        return undefined;
+    return { idle: fields[3], total: fields.reduce((a, b) => a + b, 0) };
+}
+
+/** The busy share between two reads, 0..1; `undefined` when it cannot be told. */
+export function busyBetween(previous, current) {
+    const total = current.total - previous.total;
+    const idle = current.idle - previous.idle;
+    if (total <= 0 || idle < 0)
+        return undefined;
+    return Math.min(1, Math.max(0, (total - idle) / total));
+}
+
+/**
+ * Waits until the guest is calm, or the bound passes. `readCpu` resolves to the counters or
+ * `undefined` (unreadable); `now`/`delay` are the driver's clock.
+ * Resolves `{ settled, waitedMs, busy, reason }`; never throws for a busy or unreadable guest.
+ */
+export async function waitForGuestSettled({ readCpu, now, delay, boundMs = GUEST_SETTLE_BOUND_MS, intervalMs = GUEST_SETTLE_INTERVAL_MS, busyThreshold = GUEST_SETTLED_BUSY, samples = GUEST_SETTLED_SAMPLES, }) {
+    const startedAt = now();
+    let previous = await readCpu();
+    if (previous === undefined)
+        return { reason: "unreadable", settled: false, waitedMs: now() - startedAt };
+    let calm = 0;
+    let busy;
+    while (true) {
+        const elapsed = now() - startedAt;
+        if (elapsed >= boundMs)
+            return { busy, reason: "bound", settled: false, waitedMs: elapsed };
+        await delay(Math.min(intervalMs, boundMs - elapsed));
+        const current = await readCpu();
+        if (current === undefined)
+            return { busy, reason: "unreadable", settled: false, waitedMs: now() - startedAt };
+        busy = busyBetween(previous, current);
+        previous = current;
+        calm = busy !== undefined && busy <= busyThreshold ? calm + 1 : 0;
+        if (calm >= samples)
+            return { busy, settled: true, waitedMs: now() - startedAt };
+    }
+}
